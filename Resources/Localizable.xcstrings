            "value": "Ergebnis kopieren"
          }
        }
      }
    },
    "Correct spelling, grammar and punctuation. Keep the wording, tone and language the same, and change as little as possible.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Korrigiere Rechtschreibung, Grammatik und Zeichensetzung. Behalte Wortwahl, Ton und Sprache bei und ändere so wenig wie möglich."
          }
        }
      }
    },
    "Could not delete history. Check folder permissions.": {
